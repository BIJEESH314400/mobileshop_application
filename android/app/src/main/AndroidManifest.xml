<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ requires this to show any notification at all.
         The app also asks for it at runtime (see ChatNotificationService). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- For the barcode scanner (Add Product's Barcode field, and later
         Sales/POS) — mobile_scanner's own manifest already declares this,
         but it's spelled out here too so it's visible in one place. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- For Shop Details "Pick on Map": geolocator reads the
         device's current GPS position to center the map and let
         the owner pin their shop's exact location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- For the voice-note mic button on Description/Notes fields:
         speech_to_text records through the device's microphone and
         feeds it to the platform's own on-device speech recognizer
         (no account, API key, or network service of ours involved). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <application
        android:label="4B Mobiles"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required on Android 11+ so speech_to_text can actually see
             the device's speech-recognition service (package
             visibility restrictions otherwise hide it, and
             initialize() would just report "not available"). -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
